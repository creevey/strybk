{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["src/index.ts", "src/cli.ts", "src/vitest/index.ts"],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.sh"],
  "ignore": ["dist/**"],
  "ignoreDependencies": ["@playwright/test", "@vitest/browser-playwright", "glob", "vitest"],
  "ignoreExportsUsedInFile": true,
}
